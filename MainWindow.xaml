<Window x:Class="DSRStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSR Studio — DARK SOULS: REMASTERED"
        Width="1360" Height="860" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource EditorBg}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 自绘标题栏（VS Code 式） ===== -->
        <Border Grid.Row="0" Background="{StaticResource TabBarBg}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Height="33">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="#FF9D9D9D" VerticalAlignment="Center" Margin="12,0,10,0" />
                    <Menu Background="Transparent" VerticalAlignment="Center" Padding="0" Height="30">
                        <MenuItem Header="文件(_F)">
                            <MenuItem Header="打开游戏目录…" Click="OpenRoot_Click" />
                            <MenuItem Header="重新扫描资源" Click="Rescan_Click" />
                            <MenuItem Header="退出" Click="Exit_Click" />
                        </MenuItem>
                        <MenuItem Header="编辑(_E)">
                            <MenuItem Header="保存当前标签    Ctrl+S" Click="Save_Click" />
                            <MenuItem Header="回滚当前文件" Click="Rollback_Click" />
                        </MenuItem>
                        <MenuItem Header="选择(_S)" IsEnabled="False" />
                        <MenuItem Header="查看(_V)">
                            <MenuItem Header="资源管理器" Click="FocusExplorer_Click" />
                            <MenuItem Header="关闭当前标签    Ctrl+W" Click="CloseTab_Click" />
                        </MenuItem>
                        <MenuItem Header="转到(_G)" IsEnabled="False" />
                        <MenuItem Header="工具(_T)">
                    <MenuItem Header="快捷修改（DSRModifier）" Click="MenuQuick_Click"/>
                </MenuItem>
                <MenuItem Header="帮助(_H)">
                            <MenuItem Header="关于 DSR Studio" Click="About_Click" />
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="TitleText" Text="DSR Studio — DARK SOULS: REMASTERED"
                           Foreground="#FF8A8A8A" FontSize="12" HorizontalAlignment="Center"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMin" Content="&#xE921;" Style="{StaticResource WinBtn}"
                            Click="Minimize_Click" ToolTip="最小化" />
                    <Button x:Name="BtnMax" Content="&#xE922;" Style="{StaticResource WinBtn}"
                            Click="MaxRestore_Click" ToolTip="最大化" />
                    <Button x:Name="BtnClose" Content="&#xE8BB;" Style="{StaticResource WinCloseBtn}"
                            Click="Close_Click" ToolTip="关闭" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="262" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 活动栏 -->
            <Border Grid.Column="0" Background="{StaticResource ActivityBg}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="ActText" Style="{StaticResource ActivityBtn}" Content="&#xE8A5;"
                                     IsChecked="True" ToolTip="文本 / FMG" Checked="Activity_Checked" Tag="text" />
                        <RadioButton x:Name="ActTexture" Style="{StaticResource ActivityBtn}" Content="&#xEB9F;"
                                     ToolTip="纹理 / TPF" Checked="Activity_Checked" Tag="texture" />
                        <RadioButton x:Name="ActParam" Style="{StaticResource ActivityBtn}" Content="&#xE8EF;"
                                     ToolTip="参数 / PARAM（v0.2）" Checked="Activity_Checked" Tag="param" />
                        <RadioButton x:Name="ActMap" Style="{StaticResource ActivityBtn}" Content="&#xE707;"
                                     ToolTip="地图 / MSB（v0.2）" Checked="Activity_Checked" Tag="map" />
                        <RadioButton x:Name="ActEvent" Style="{StaticResource ActivityBtn}" Content="&#xE943;"
                                     ToolTip="事件 / EMEVD（v0.3）" Checked="Activity_Checked" Tag="event" />
                        <RadioButton x:Name="ActModel" Style="{StaticResource ActivityBtn}" Content="&#xE7C1;"
                                     ToolTip="模型 / FLVER（v0.3）" Checked="Activity_Checked" Tag="model" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <RadioButton x:Name="ActBackup" Style="{StaticResource ActivityBtn}" Content="&#xE81C;"
                                     ToolTip="备份与回滚" Checked="Activity_Checked" Tag="backup" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 侧栏 -->
            <Border Grid.Column="1" Background="{StaticResource SidebarBg}"
                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,2">
                        <TextBlock x:Name="SideTitle" Text="资源管理器" Style="{StaticResource SectionHeader}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="SideCount" Style="{StaticResource DimText}" HorizontalAlignment="Right"
                                   Margin="0,0,12,0" VerticalAlignment="Center" />
                    </Grid>

                    <ListBox x:Name="SideList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SideItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="SideList_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource UiText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource DimText}"
                                               FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0"
                            Padding="20,8">
                        <TextBlock x:Name="SideHint" Style="{StaticResource DimText}" FontSize="11"
                                   TextWrapping="Wrap" Text="双击条目打开" />
                    </Border>
                </Grid>
            </Border>

            <!-- 编辑区 -->
            <Grid Grid.Column="2" Background="{StaticResource EditorBg}">
                <TabControl x:Name="Tabs" Background="{StaticResource TabBarBg}"
                            BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource VsTab}">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource TabBarBg}">
                                    <TabPanel IsItemsHost="True" Margin="0" />
                                </Border>
                                <Border Grid.Row="1" Background="{StaticResource EditorBg}">
                                    <ContentPresenter ContentSource="SelectedContent" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>
                </TabControl>

                <Grid x:Name="EmptyHint" Background="{StaticResource EditorBg}" Panel.ZIndex="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="DSR STUDIO" FontFamily="Cascadia Mono, Consolas" FontSize="26"
                                   Foreground="#FF3A3A3A" HorizontalAlignment="Center" />
                        <TextBlock Text="从左侧资源列表双击打开文件" Style="{StaticResource DimText}"
                                   Margin="0,10,0,0" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyRoot" Style="{StaticResource MonoText}" FontSize="11"
                                   Foreground="#FF4A4A4A" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== 状态栏 ===== -->
        <Border Grid.Row="2" Background="{StaticResource StatusBg}" Height="22">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusDomain" Text="文本" Foreground="White" FontSize="12" />
                    <TextBlock Text="  ·  " Foreground="#B3FFFFFF" FontSize="12" />
                    <TextBlock x:Name="StatusInfo" Text="就绪" Foreground="White" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusDirty" Text="" Foreground="#FFFFE08A" FontSize="12" Margin="0,0,14,0" />
                    <TextBlock x:Name="StatusRoot" Text="" Foreground="#CCFFFFFF" FontSize="11.5" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
