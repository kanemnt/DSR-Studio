<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== VS Code Dark+ 调色板 ===== -->
    <SolidColorBrush x:Key="ActivityBg" Color="#FF333333" />
    <SolidColorBrush x:Key="SidebarBg" Color="#FF252526" />
    <SolidColorBrush x:Key="EditorBg" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="TabBarBg" Color="#FF252526" />
    <SolidColorBrush x:Key="TabActiveBg" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="TabInactiveBg" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="MenuBg" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="StatusBg" Color="#FF007ACC" />
    <SolidColorBrush x:Key="Accent" Color="#FF007ACC" />
    <SolidColorBrush x:Key="TextFg" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="TextDim" Color="#FF858585" />
    <SolidColorBrush x:Key="TextBright" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BorderSoft" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="BorderMid" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="HoverBg" Color="#FF2A2D2E" />
    <SolidColorBrush x:Key="SelectBg" Color="#FF094771" />
    <SolidColorBrush x:Key="InputBg" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="WarnFg" Color="#FFCCA700" />
    <SolidColorBrush x:Key="ErrFg" Color="#FFF14C4C" />
    <SolidColorBrush x:Key="OkFg" Color="#FF89D185" />

    <!-- ===== 文本 ===== -->
    <Style x:Key="UiText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextFg}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
    </Style>
    <Style x:Key="DimText" TargetType="TextBlock" BasedOn="{StaticResource UiText}">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style x:Key="MonoText" TargetType="TextBlock" BasedOn="{StaticResource UiText}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFBBBBBB" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="Margin" Value="20,10,0,6" />
    </Style>

    <!-- ===== 活动栏按钮 ===== -->
    <Style x:Key="ActivityBtn" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#99FFFFFF" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Width="48" Height="46" Background="Transparent">
                        <Border x:Name="Bar" Width="2" HorizontalAlignment="Left" Background="Transparent" />
                        <TextBlock x:Name="Ico" Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets"
                                   FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBright}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBright}" />
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource TextBright}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 侧栏条目 ===== -->
    <Style x:Key="SideItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextFg}" />
        <Setter Property="Padding" Value="20,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="6,1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBg}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 标签页 ===== -->
    <Style x:Key="VsTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Bd" Background="{StaticResource TabInactiveBg}" CornerRadius="6,6,0,0"
                                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,1,0">
                            <Grid Margin="12,0" Height="34">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="Top" Height="1" VerticalAlignment="Top" Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TabActiveBg}" />
                            <Setter TargetName="Top" Property="Background" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBright}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextFg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 表格 ===== -->
    <Style x:Key="VsHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#FF252526" />
        <Setter Property="Foreground" Value="#FFBBBBBB" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderMid}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VsCell" TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource TextFg}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectBg}" />
                <Setter Property="Foreground" Value="{StaticResource TextBright}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="VsRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="26" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF2A2D2E" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectBg}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="VsGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource EditorBg}" />
        <Setter Property="Foreground" Value="{StaticResource TextFg}" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource VsHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource VsCell}" />
        <Setter Property="RowStyle" Value="{StaticResource VsRow}" />
        <Setter Property="HorizontalGridLinesBrush" Value="Transparent" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- ===== 滚动条 ===== -->
    <Style x:Key="VsThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="#55FFFFFF" CornerRadius="4" Margin="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="VsScrollThumbStyle" TargetType="Thumb">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="#66FFFFFF" CornerRadius="5" Margin="3,2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="#FF1B1B1B" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource VsScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="12" />
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="12" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 按钮 / 输入 ===== -->
    <Style x:Key="VsBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextFg}" />
        <Setter Property="Background" Value="{StaticResource InputBg}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF505050" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VsPrimaryBtn" TargetType="Button" BasedOn="{StaticResource VsBtn}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="{StaticResource TextBright}" />
    </Style>

    <Style x:Key="VsInput" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource InputBg}" />
        <Setter Property="Foreground" Value="{StaticResource TextFg}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBright}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#FF3C3C3C" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 菜单 ===== -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource MenuBg}" />
        <Setter Property="Foreground" Value="{StaticResource TextFg}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextFg}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="10,5">
                        <Grid>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False">
                                <Border Background="#FF252526" BorderBrush="{StaticResource BorderMid}" BorderThickness="1" CornerRadius="6"
                                        Padding="4" MinWidth="180">
                                    <StackPanel IsItemsHost="True" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 自绘标题栏窗口按钮 ===== -->
    <Style x:Key="WinBtn" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFCCCCCC" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF3E3E42" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFE81123" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 下拉框（深色，VS Code 风格） ===== -->
    <Style x:Key="VsComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#FFCCCCCC" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="6,1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF094771" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VsCombo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="#FFCCCCCC" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="24" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource VsComboItem}" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="#FF3C3C3C" BorderBrush="#FF454545" BorderThickness="1"
                                            CornerRadius="4">
                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                   Foreground="#FFCCCCCC" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="8,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="#FF252526" BorderBrush="#FF454545" BorderThickness="1" CornerRadius="6"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>


